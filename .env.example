# MGX ARC GUI — environment variables
# Copy to .env on the server (gitignored). Do not commit real secrets.
#
# systemd: use EnvironmentFile=/opt/mgx-arc-gui/.env in a drop-in, or set
# variables in /etc/systemd/system/mgx-arc-gui.service.d/override.conf

# ---------------------------------------------------------------------------
# Application listen port
# ---------------------------------------------------------------------------
# Dev default: 4282 (python app.py). Production systemd default: 4281.
PORT=4281

# ---------------------------------------------------------------------------
# Fleet Health Console — credentials (required for /api/arc when systems.yaml
# references arc-bmc / arc-host credential refs)
# ---------------------------------------------------------------------------
MGX_ARC_BMC_USERNAME=
MGX_ARC_BMC_PASSWORD=
MGX_ARC_HOST_USERNAME=
MGX_ARC_HOST_PASSWORD=

# ---------------------------------------------------------------------------
# Config and runtime data paths
# ---------------------------------------------------------------------------
# Override YAML config directory (default: config/mgx_arc/)
# MGX_ARC_CONFIG_DIR=/opt/mgx-arc-gui/config/mgx_arc

# Override snapshot / store database directory (default: data/ under project root)
# MGX_ARC_DATA_DIR=/var/lib/mgx-arc-gui

# ---------------------------------------------------------------------------
# Direct Connect BMC gate (app.py — NOT env-backed today)
# ---------------------------------------------------------------------------
# Direct Connect login validates against hardcoded constants in app.py:
#   REQUIRED_BMC_USER = "root"
#   REQUIRED_BMC_PASSWORD = "0penBmc"
# Change those in app.py (or refactor to env) before exposing the GUI beyond
# a closed lab network. See SECURITY.md.

# ---------------------------------------------------------------------------
# NVIDIA SSO / Azure AD OIDC (env-gated — default off for lab/Spark)
# ---------------------------------------------------------------------------
# Register the app in ITSS Applications (OIDC Authorization Code + PKCE).
# See docs/SSO.md, HANDOFF_NOW.md. Enable after ITSS app registration.
#
SSO_ENABLED=false
# SECRET_KEY=                  # Required for signed sessions when SSO_ENABLED=true
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=          # Only if ITSS registers a confidential client
# OIDC_TENANT_ID=              # Azure AD / NVIDIA SSO tenant GUID
# OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
# OIDC_REDIRECT_URI=https://mgx-arc-gui.example.nvidia.com/oauth2/callback
# OIDC_SCOPES=openid profile email

# ---------------------------------------------------------------------------
# Redfish / power OEM paths (optional — defaults match current MGX ARC BMCs)
# ---------------------------------------------------------------------------
# POWER_SYSTEM_PATH=/Systems/System_0
# AUX_POWER_RESET_PATH=/Chassis/BMC_0/Actions/Oem/NvidiaChassis.AuxPowerReset
# BMC_MANAGER_RESET_PATH=/Managers/BMC_0/Actions/Manager.Reset

# ---------------------------------------------------------------------------
# Operation timeouts (seconds) — optional tuning
# ---------------------------------------------------------------------------
# FLASH_UPLOAD_TIMEOUT=900
# TASK_ACTIVATION_GRACE=45
# BMC_UPDATE_TIMEOUT=600
# SPI_READ_TIMEOUT=900
# USB_ENUM_TIMEOUT=30
# PCIE_LSPCI_TIMEOUT=30
# I2C_CMD_TIMEOUT=60

# ---------------------------------------------------------------------------
# Lab scope integration (optional)
# ---------------------------------------------------------------------------
# SCOPE_SCPI_PORTS=5025,4000,5555
# SCOPE_CONNECT_TIMEOUT=4
# SCOPE_IO_TIMEOUT=12
# SCOPE_VNC_PORT=5900
# SCOPE_WAVE_POINTS=1000

# ---------------------------------------------------------------------------
# Spark / remote deploy helper only (deploy/push_to_spark.py — NOT required
# for ITSS VM production deploy)
# ---------------------------------------------------------------------------
# SPARK_HOST=10.110.33.21
# SPARK_USER=
# SPARK_PASSWORD=
# SPARK_APP_DIR=/home/${SPARK_USER}/MGXARC-GUI-RIDDHI
